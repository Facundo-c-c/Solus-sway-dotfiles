{
    "position": "top",
    "height": 40,
    "modules-left": ["custom/music"],
    "modules-center": ["sway/workspaces"],
    "modules-right": ["tray","custom/separator","network","custom/separator","pulseaudio","custom/separator","clock"],

    "clock": {
        "format": "  {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    },

    "sway/workspaces": {
    	"all-outputs": true,	
    "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "7": "",
            "8": "",
            "9": "",
            "focused": ""
        },
	"persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
	 },
	},

    "tray": {
        "icon-size": 17,
        "spacing":3,
    },

    "custom/separator": {
        "format": "|",
        "interval": "once",
        "tooltip": false
   },

    "pulseaudio": {
       "scroll-step": 5,
        "format":"{icon}  {volume}%",
        "format-icons": {
        "default": ["","","",""]
      },
      "on-click":"pavucontrol"
    },

    "network": {
	"interface": "wlp1s0",
	"format": "{ifname}",
	"format-wifi":"  {essid}",
	"format-ethernet": "{ifname} " ,
	"format-disconnected":"󰖪 ",
	"format-disconnected":"󰖪 ",
	"tooltip-format": "{ifname}",
	"tooltip-format-wifi": " {essid} ({signalStrength}%)   ",
	"tooltip-format-ethernet": "{ifname}  ",
	"tooltip-format-disconnected": "Disconnected",
	"max-length": 60,
    "on-click":"nmcli networking off",
    "on-click-right": "nmcli networking on",
    "on-click-middle": "sh ~/.config/wofi/wofi-wifi-menu.sh"
    },

   "custom/logo": {
    "format": "",
    "interval": "once",
    "tooltip": false,
    "on-click":"wofi --show drun",
    },
    "wlr/taskbar": {
	"format": "{icon}",
	"icon-size": 25,
    "icon-theme":"Gruvbox-Plus-Dark",
	"tooltip-format": "{title}",
	"on-click": "minimize-raise",
	"on-click-middle": "close",
	"ignore-list": [
	    "waybar"
	],
	"app_ids-mapping": {
		"firefoxdeveloperedition": "firefox-developer-edition"
	},
	"rewrite": {
		"Firefox Web Browser": "Firefox",
		"Foot Server": "Terminal"
	},
},
"custom/music": {
    "format": "{icon}{}",
    "format-icons": {
        "Playing": " ", // Uncomment if not using caway
        "Paused": " ",
        "Stopped": "" // This stop symbol is RTL. So &#x202d; is left-to-right override.
    },
    "escape": true,
    "tooltip": true,
    "exec": "sh ~/.config/waybar/module/caway/caway -e",
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next",
    "on-click-right": "g4music",
    "max-length": 30
}
}
